# Copiez ce fichier en .env et renseignez-le.
#
#   cp .env.exemple .env
#   openssl rand -hex 32

# OBLIGATOIRE. Trente-deux caractères au moins. Le service refuse de démarrer
# sans lui, et changer sa valeur déconnecte tout le monde.
MDF_JWT_SECRET=

# OBLIGATOIRE dès qu'un courriel part : les liens des messages sont absolus.
# C'est l'adresse que la famille tape dans son navigateur.
MDF_PUBLIC_URL=https://maison.exemple.fr

# Relais SMTP. Sans lui, les notifications sont enregistrées mais ne partent
# pas, et l'écran d'état le dit. Utilisez un mot de passe d'application dédié,
# jamais le mot de passe principal de la boîte.
MDF_SMTP_HOST=
MDF_SMTP_PORT=587
MDF_SMTP_USER=
MDF_SMTP_PASS=
MDF_SMTP_FROM=Maison de Famille <maison@exemple.fr>

# Uniquement si l'application est servie sous un sous-chemin, par exemple
# https://exemple.fr/maison/ . Laissez « / » pour un sous-domaine dédié.
MDF_BASE_HREF=/

# Version affichée dans l'écran d'état.
MDF_VERSION=dev
